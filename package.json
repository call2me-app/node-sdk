{
  "name": "call2me-sdk",
  "version": "1.5.2",
  "description": "Call2Me Node.js SDK \u2014 Build AI voice agents",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.mjs",
      "require": "./src/index.js"
    },
    "./voice": {
      "types": "./src/voice.d.ts",
      "default": "./src/voice.js"
    }
  },
  "files": [
    "src/"
  ],
  "license": "MIT",
  "homepage": "https://call2me.app",
  "repository": "https://github.com/call2me-app/node-sdk",
  "keywords": [
    "voice-ai",
    "call2me",
    "ai-agents",
    "voice-agents"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "livekit-client": ">=2"
  },
  "peerDependenciesMeta": {
    "livekit-client": {
      "optional": true
    }
  }
}
